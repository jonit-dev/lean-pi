{
	"name": "leanpi",
	"version": "0.1.0",
	"description": "Cost-aware task compiler and coding runtime built on Pi",
	"license": "MIT",
	"author": "Joao Paulo Furtado <admin@coldstartlabs.ca>",
	"homepage": "https://github.com/jonit-dev/lean-pi#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonit-dev/lean-pi.git"
	},
	"bugs": {
		"url": "https://github.com/jonit-dev/lean-pi/issues"
	},
	"keywords": [
		"coding-agent",
		"cost-optimization",
		"llm",
		"pi",
		"task-compiler"
	],
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"bin",
		"dist",
		"skills",
		"themes",
		"src/capability/models.json",
		"src/core/instructions/ponytail.md",
		"src/core/instructions/ponytail.lock.json"
	],
	"scripts": {
		"build": "tsc -p tsconfig.json",
		"leanpi": "tsc -p tsconfig.json && node ./bin/leanpi.js",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "oxlint src tests",
		"sync:ponytail": "node scripts/sync-ponytail.mjs",
		"bench:skills": "vitest run --config vitest.bench.config.ts",
		"bench": "tsc -p tsconfig.json && node dist/bench/lane.js",
		"sync:skills": "node scripts/sync-skills.mjs"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "^0.86.1",
		"@earendil-works/pi-ai": "^0.86.1",
		"@earendil-works/pi-coding-agent": "^0.86.1",
		"@earendil-works/pi-tui": "^0.86.1",
		"@hk_net/pi-usage-bars": "^0.6.0",
		"pi-claude-code-ui": "^1.0.83",
		"typebox": "^1.0.0",
		"yaml": "^2.8.1"
	},
	"devDependencies": {
		"@types/node": "^22.10.0",
		"oxlint": "^1.30.0",
		"typescript": "^5.9.3",
		"vitest": "^3.2.4"
	},
	"bin": {
		"leanpi": "./bin/leanpi.js"
	}
}
