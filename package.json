{
	"name": "leanpi",
	"version": "0.1.4",
	"description": "Cost-aware task compiler and coding runtime built on Pi",
	"license": "MIT",
	"author": "Joao Paulo Furtado <admin@coldstartlabs.ca>",
	"homepage": "https://github.com/jonit-dev/lean-pi#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/jonit-dev/lean-pi.git"
	},
	"bugs": {
		"url": "https://github.com/jonit-dev/lean-pi/issues"
	},
	"keywords": [
		"coding-agent",
		"cost-optimization",
		"llm",
		"pi",
		"task-compiler"
	],
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=22.19.0"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"bin",
		"dist",
		"scripts/patch-pi-model-command.mjs",
		"extensions",
		"skills",
		"themes",
		"src/capability/models.json",
		"src/cli/fold-cache.ts",
		"src/cli/spinner.ts",
		"src/core/instructions/ponytail.md",
		"src/core/instructions/ponytail.lock.json",
		"vendor"
	],
	"scripts": {
		"build": "node scripts/vendor-thinking-fold.mjs && tsc -p tsconfig.json",
		"prepack": "node scripts/vendor-thinking-fold.mjs && tsc -p tsconfig.json",
		"prepublishOnly": "npm run build && npm run typecheck && npm run lint && npm test && npm run bench:cost-gate",
		"release": "npm publish",
		"leanpi": "node scripts/vendor-thinking-fold.mjs 2> /dev/null && tsc -b tsconfig.json && node ./bin/leanpi.js",
		"vendor:thinking-fold": "node scripts/vendor-thinking-fold.mjs",
		"link:bin": "pnpm install && mkdir -p ~/.local/bin && ln -sf \"$PWD/scripts/leanpi-local.sh\" ~/.local/bin/leanpi && ~/.local/bin/leanpi --version",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"lint": "oxlint src tests",
		"sync:ponytail": "node scripts/sync-ponytail.mjs",
		"bench:skills": "vitest run --config vitest.bench.config.ts",
		"bench:cost-gate": "node bench/cost/gate.mjs",
		"bench": "node scripts/vendor-thinking-fold.mjs && tsc -p tsconfig.json && node dist/bench/lane.js",
		"sync:skills": "node scripts/sync-skills.mjs",
		"record:demo": "bash scripts/record-demo.sh"
	},
	"dependencies": {
		"@99percentpeople/pi-thinking-fold": "^0.1.11",
		"@earendil-works/pi-agent-core": "^0.87.1",
		"@earendil-works/pi-ai": "^0.87.1",
		"@earendil-works/pi-coding-agent": "^0.87.1",
		"@earendil-works/pi-tui": "^0.87.1",
		"@hk_net/pi-usage-bars": "^0.6.0",
		"pi-claude-code-ui": "^1.0.83",
		"pi-patty-bg-tasks": "1.1.6",
		"pi-subagents": "0.70.1",
		"typebox": "^1.0.0",
		"yaml": "^2.8.1"
	},
	"devDependencies": {
		"@types/node": "^26.6.2",
		"oxlint": "^1.30.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	},
	"bin": {
		"leanpi": "./bin/leanpi.js"
	}
}
